# ============================================================
# Home Soil 2026 — Environment Variables
# Copy to your hosting provider (Vercel → Project → Settings → Environment Variables).
# NEVER commit real values. These stay server-side only.
# ============================================================

# --- Stripe (payments) ---
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
# Stripe Tax (destination-based sales tax). OFF unless set to exactly "on".
# Enable Stripe Tax + add tax registrations in the dashboard FIRST, and wire the
# frontend to call /api/calculate-tax — see TAX-SETUP.md. Until then, leave unset
# (the store uses the legacy flat 8% rate).
# STRIPE_TAX=on
# Optional: product tax code (default txcd_99999999 = general tangible goods).
# Set a clothing code if you sell into states that exempt apparel (PA, NJ, MN…).
# STRIPE_TAX_CODE=txcd_99999999
# Publishable key goes in the FRONT-END STORE_CONFIG (it's safe to expose):
# STORE_CONFIG.stripePublishableKey = 'pk_live_xxxx'

# --- Printful (fulfillment) ---
# Printful → Settings → Stores → API → "Add API token"
PRINTFUL_API_TOKEN=xxxxxxxxxxxx
PRINTFUL_STORE_ID=xxxxxxxx

# --- Supabase (database) ---
# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxx

# --- Owner admin (product management) ---
# Any strong password. Checked server-side by /api/admin-auth; never shipped to the
# browser. Access the dashboard privately at  https://homesoil2026.com/#owner
ADMIN_PASSWORD=choose-a-strong-password

# --- Email (transactional, e.g. Resend) ---
# https://resend.com → API Keys  (optional for MVP — Printful also emails tracking)
RESEND_API_KEY=re_xxxxxxxxxxxx
STORE_FROM_EMAIL=orders@homesoil2026.com
