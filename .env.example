# ============================================================
# Home Soil 2026 — Environment Variables
# Copy to your hosting provider (Vercel → Project → Settings → Environment Variables).
# NEVER commit real values. These stay server-side only.
# ============================================================

# --- Stripe (payments) ---
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
# Stripe Tax (destination-based sales tax). OFF unless set to exactly "on".
# Enable Stripe Tax + add tax registrations in the dashboard FIRST, and wire the
# frontend to call /api/calculate-tax — see TAX-SETUP.md. Until then, leave unset
# (the store uses the legacy flat 8% rate).
# STRIPE_TAX=on
# Optional: product tax code (default txcd_99999999 = general tangible goods).
# Set a clothing code if you sell into states that exempt apparel (PA, NJ, MN…).
# STRIPE_TAX_CODE=txcd_99999999
# Publishable key goes in the FRONT-END STORE_CONFIG (it's safe to expose):
# STORE_CONFIG.stripePublishableKey = 'pk_live_xxxx'

# --- Printify (products + fulfillment) ---
# You design products by hand in Printify; this store syncs them automatically
# and places orders on payment. See PRINTIFY-SETUP.md.
# Token: Printify → My profile → Connections → "Generate" (Personal Access Token)
PRINTIFY_API_TOKEN=xxxxxxxxxxxx
# Shop id: GET https://api.printify.com/v1/shops.json (or admin → Sync from Printify
# with {listShops:true}). It's a number like 12345678.
PRINTIFY_SHOP_ID=xxxxxxxx
# Random string you also give Printify when registering webhooks; used to verify
# webhook signatures. Strongly recommended (the receiver allows unsigned only when unset).
PRINTIFY_WEBHOOK_SECRET=choose-a-random-string
# Set to exactly "true" to auto-send paid orders to production (charges your
# Printify balance). Leave unset to approve each order with one click in Printify.
# PRINTIFY_AUTO_FULFILL=true

# --- Supabase (database) ---
# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxx

# --- Fan engagement features (Match Center + Pick'em) ---
# Free football data API for the World Cup schedule/scores/standings.
# Register at https://www.football-data.org/client/register (competition code WC).
# Without it, the Match Center/Pick'em show a graceful "coming soon" state.
FOOTBALL_DATA_TOKEN=xxxxxxxxxxxx
# Single store-wide promo code emailed to Pick'em entrants (applied at checkout).
PROMO_CODE=PICKEM10
PROMO_PERCENT=10
# Optional: protects /api/score-predictions when run as a Vercel Cron. If set, the
# cron must send Authorization: Bearer <CRON_SECRET> (Vercel does this for you).
CRON_SECRET=choose-a-random-string

# --- Owner admin (product management) ---
# Any strong password. Checked server-side by /api/admin-auth; never shipped to the
# browser. Access the dashboard privately at  https://homesoil2026.com/#owner
ADMIN_PASSWORD=choose-a-strong-password

# --- Email (transactional, e.g. Resend) ---
# https://resend.com → API Keys  (optional for MVP — Printify also emails tracking)
RESEND_API_KEY=re_xxxxxxxxxxxx
STORE_FROM_EMAIL=orders@homesoil2026.com
